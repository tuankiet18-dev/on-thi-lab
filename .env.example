# Copy this file to .env.local. Never commit .env.local or real credentials.
APP_ENV=development
LOG_LEVEL=debug

# Public web configuration. VITE_* values are included in the browser bundle.
VITE_API_URL=http://localhost:8787
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/

# Server configuration.
DATABASE_URL=postgresql://onthilab:onthilab@localhost:5432/onthilab
AWS_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
QUESTION_IMAGE_BASE_URL=
QUESTION_IMAGE_STORAGE_PATH=.local-storage/question-images

# Feature flags default to false until their integration is production-ready.
FEATURE_GOOGLE_AUTH_ENABLED=false
FEATURE_AI_IMPORT_ENABLED=false
FEATURE_MONETIZATION_ENABLED=false
FEATURE_REGISTRATION_ENABLED=true

# AI provider credentials are server-only.
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=

# payOS credentials are server-only. Never prefix these with VITE_.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_WEBHOOK_URL=
