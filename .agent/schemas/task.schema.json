{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex implementation contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "title",
    "objective",
    "risk",
    "baseSha",
    "executor",
    "allowedPaths",
    "forbiddenPaths",
    "contextFiles",
    "acceptanceCriteria",
    "verification",
    "rollback",
    "escalateIf"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "taskId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "objective": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["L0", "L1", "L2", "L3"] },
    "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "effort",
        "selectedBy",
        "timeout",
        "maxTotalTokens"
      ],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "effort": { "enum": ["low", "medium", "high"] },
        "selectedBy": { "const": "codex" },
        "overrideReason": { "type": "string", "minLength": 1 },
        "priorAttempts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model", "effort", "outcome"],
            "properties": {
              "model": { "type": "string", "minLength": 1 },
              "effort": { "enum": ["low", "medium", "high"] },
              "outcome": { "type": "string", "minLength": 1 }
            }
          }
        },
        "timeout": { "type": "string", "pattern": "^[1-9][0-9]*[smh]$" },
        "maxTotalTokens": { "type": "integer", "minimum": 1000 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "model": { "not": { "const": "gemini-3.7-flash-medium" } }
            },
            "required": ["model"]
          },
          "then": { "required": ["overrideReason"] }
        },
        {
          "if": {
            "properties": {
              "model": {
                "not": {
                  "enum": ["gemini-3.7-flash-medium", "gemini-3.7-flash-high"]
                }
              }
            },
            "required": ["model"]
          },
          "then": {
            "required": ["overrideReason", "priorAttempts"],
            "properties": {
              "effort": { "const": "high" },
              "priorAttempts": {
                "contains": {
                  "type": "object",
                  "required": ["model", "effort"],
                  "properties": {
                    "model": { "const": "gemini-3.7-flash-high" },
                    "effort": { "const": "high" }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "allowedPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "forbiddenPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "contextFiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "verification"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[1-9][0-9]*$" },
          "statement": { "type": "string", "minLength": 1 },
          "verification": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "argv", "required"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "argv": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "required": { "type": "boolean" }
        }
      }
    },
    "rollback": { "type": "string", "minLength": 1 },
    "escalateIf": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    }
  }
}
