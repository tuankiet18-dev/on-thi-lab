{
  "name": "@onthilab/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env.local src/dev.ts",
    "migrate": "pnpm --filter @onthilab/database migrate",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/client-sqs": "^3.1098.0",
    "@aws-sdk/client-ssm": "^3.1098.0",
    "@aws-sdk/s3-request-presigner": "^3.1098.0",
    "@hono/node-server": "^2.0.10",
    "@onthilab/contracts": "workspace:*",
    "@onthilab/database": "workspace:*",
    "@onthilab/importer": "workspace:*",
    "@onthilab/worker": "workspace:*",
    "aws-jwt-verify": "^5.1.0",
    "hono": "^4.8.5",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
